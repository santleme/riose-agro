{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riose.local/schemas/asset.schema.json",
  "title": "Riose semantic asset",
  "type": "object",
  "required": [
    "id",
    "category",
    "family",
    "file",
    "source",
    "dimensions",
    "footprint",
    "anchor",
    "tags",
    "styleVersion",
    "status",
    "references",
    "rights",
    "name",
    "description",
    "materials",
    "orientations",
    "assetVersion",
    "regionalCompatibility",
    "distributionPackage",
    "frames",
    "history",
    "colorProfile",
    "technicalPolicy",
    "fileSha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "livestock",
        "pasture",
        "fence",
        "corral",
        "water",
        "feed",
        "infrastructure",
        "technology",
        "building",
        "vehicle",
        "vegetation",
        "prop"
      ]
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "tool",
        "sourceFile",
        "createdAt"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ai-generated",
            "ai-assisted",
            "human-authored",
            "derived",
            "unknown",
            "legacy-unknown"
          ]
        },
        "tool": {
          "type": "string"
        },
        "modelVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceFile": {
          "type": "string"
        },
        "promptFile": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "required": [
        "width",
        "height",
        "format",
        "alpha"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "PNG"
          ]
        },
        "alpha": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "footprint": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "anchor": {
      "type": "object",
      "required": [
        "x",
        "y",
        "meaning"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "meaning": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scenarioCompatibility": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "styleVersion": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "REVIEW",
        "APPROVED",
        "RELEASED",
        "REJECTED"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rights": {
      "type": "object",
      "required": [
        "licenseState",
        "notes"
      ],
      "properties": {
        "licenseState": {
          "type": "string",
          "enum": [
            "project-generated-review",
            "documented",
            "unknown"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "technologyClass": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "U"
      ]
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reference",
          "scope",
          "claimSummary",
          "reviewer",
          "reviewerRole"
        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "sourceDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": "string"
          },
          "claimSummary": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "reviewerRole": {
            "type": "string",
            "enum": [
              "domain-expert",
              "technical-reviewer",
              "visual-reviewer"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "claimLimits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depictionMode": {
      "type": "string",
      "enum": [
        "physical-device",
        "event",
        "status-overlay",
        "estimated-state",
        "simulation",
        "concept"
      ]
    },
    "dataContract": {
      "type": "object",
      "required": [
        "requiredUpstreamState",
        "unavailableBehavior"
      ],
      "properties": {
        "requiredUpstreamState": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unavailableBehavior": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "atlas": {
      "type": [
        "object",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "required": [
        "art",
        "technical",
        "decisionNote"
      ],
      "properties": {
        "art": {
          "type": "string",
          "enum": [
            "pending",
            "pass",
            "revise",
            "reject"
          ]
        },
        "technical": {
          "type": "string",
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        },
        "decisionNote": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "orientations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "assetVersion": {
      "type": "string",
      "pattern": "^v[0-9]+-[a-z0-9-]+$"
    },
    "regionalCompatibility": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "distributionPackage": {
      "type": "string",
      "minLength": 1
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "frameIndex"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "frameIndex": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event",
          "date",
          "detail"
        ],
        "properties": {
          "event": {
            "type": "string"
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "colorProfile": {
      "type": "string",
      "enum": [
        "embedded-srgb",
        "unverified"
      ]
    },
    "technicalPolicy": {
      "type": "object",
      "required": [
        "alphaMode",
        "paddingMinPx"
      ],
      "properties": {
        "alphaMode": {
          "type": "string",
          "enum": [
            "hard-edge-sprite",
            "binary-alpha-tile",
            "soft-alpha-sprite"
          ]
        },
        "paddingMinPx": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "fileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "releaseRecord": {
      "type": "object",
      "required": [
        "package",
        "version",
        "sha256",
        "consumer",
        "graphicsManifest"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "graphicsManifest": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "technologyClass": {
            "enum": [
              "A",
              "B"
            ]
          }
        },
        "required": [
          "technologyClass"
        ]
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "RELEASED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "releaseRecord"
        ]
      }
    }
  ]
}
