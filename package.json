{
  "name": "agroville-mvp",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build:wasm": "sh scripts/build-wasm.sh",
    "bench:simulation": "node scripts/benchmark-simulation.mjs",
    "bench:history": "node scripts/benchmark-history.mjs",
    "bench:history-storage": "node --expose-gc scripts/benchmark-history-storage.mjs",
    "bench:browser": "node scripts/benchmark-browser.mjs",
    "build:graphics-poc": "node scripts/build-graphics-poc.mjs",
    "bench:graphics-poc": "npm run build:graphics-poc && node scripts/benchmark-graphics-poc.mjs",
    "bench:rust-native": "cargo run --release -p riose-core --bin bench-metabolism",
    "archive:comparison": "node scripts/archive-comparison.js",
    "validate:outcome": "node scripts/validate-outcome-record.js",
    "link:snapshot": "node scripts/link-farm-snapshot.js",
    "validate:snapshot": "node scripts/validate-farm-snapshot.js",
    "build:observed-data": "python3 scripts/build_observed_calf_dataset.py",
    "audit:usda-cper": "python3 scripts/audit_usda_cper_validation.py",
    "audit:usda-cper-daily": "python3 scripts/audit_usda_cper_daily.py",
    "audit:rothamsted-adg": "python3 scripts/audit_rothamsted_adg.py"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  }
}
