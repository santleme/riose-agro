{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agroville Observed Outcome Record",
  "description": "Local sidecar linking post-decision observations to an immutable comparison archive. It does not update or recalibrate the simulation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "outcomeId", "createdAt", "decision", "governance", "review", "projection", "subject", "observations"],
  "properties": {
    "type": {"const": "agroville-outcome-record"},
    "version": {"const": 1},
    "outcomeId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "occurredAt", "executedScenario"],
      "properties": {
        "status": {"enum": ["implemented", "partially-implemented", "not-implemented", "unknown"]},
        "occurredAt": {"type": ["string", "null"], "format": "date-time"},
        "executedScenario": {"enum": ["baseline", "scenario", "unknown"]},
        "note": {"type": "string"}
      }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["consentStatus", "consentBasis", "accessStatus", "accessBasis", "retentionPolicy"],
      "properties": {
        "consentStatus": {"enum": ["granted", "not-required", "pending", "withdrawn"]},
        "consentBasis": {"type": "string", "minLength": 1},
        "accessStatus": {"enum": ["public", "authorized", "pending", "withdrawn"]},
        "accessBasis": {"type": "string", "minLength": 1},
        "retentionPolicy": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected"]},
        "reviewerId": {"type": "string", "minLength": 1},
        "reviewedAt": {"type": "string", "format": "date-time"},
        "note": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["approved", "rejected"]}}, "required": ["status"]}, "then": {"required": ["reviewerId", "reviewedAt"]}}
      ]
    },
    "projection": {
      "type": "object", "additionalProperties": false,
      "required": ["archiveSha256", "manifestSha256"],
      "properties": {
        "archiveSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["entityId", "level", "populationDescription", "snapshotSha256"],
      "properties": {
        "entityId": {"type": "string", "minLength": 1},
        "level": {"enum": ["animal", "lot", "farm"]},
        "populationDescription": {"type": "string", "minLength": 1},
        "snapshotSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "observations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "metricPath", "scenario", "status", "value", "unit", "observedAt", "periodDays", "method", "sourceId", "sourceTitle", "sourceVersion", "sourceLocator", "quality", "alignment"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "metricPath": {"type": "string", "minLength": 1},
          "scenario": {"enum": ["baseline", "scenario"]},
          "status": {"enum": ["observed", "missing"]},
          "value": {"type": ["number", "null"]},
          "unit": {"type": "string", "minLength": 1},
          "observedAt": {"type": ["string", "null"], "format": "date-time"},
          "periodStart": {"type": ["string", "null"], "format": "date"},
          "periodEnd": {"type": ["string", "null"], "format": "date"},
          "periodDays": {"type": "integer", "minimum": 1},
          "method": {"type": "string", "minLength": 1},
          "sourceId": {"type": "string", "minLength": 1},
          "sourceTitle": {"type": "string", "minLength": 1},
          "sourceVersion": {"type": "string", "minLength": 1},
          "sourceLocator": {"type": "string", "minLength": 1},
          "quality": {"enum": ["measured", "derived", "estimated", "unknown"]},
          "missingReason": {"type": "string"},
          "alignment": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "basis"],
            "properties": {
              "status": {"enum": ["pending", "approved", "not-comparable"]},
              "basis": {"type": "string", "minLength": 1},
              "reviewerId": {"type": "string", "minLength": 1},
              "reviewedAt": {"type": "string", "format": "date-time"}
            },
            "allOf": [
              {"if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]}, "then": {"required": ["reviewerId", "reviewedAt"]}}
            ]
          }
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "missing"}}, "required": ["status"]}, "then": {"properties": {"value": {"type": "null"}}, "required": ["missingReason"]}},
          {"if": {"properties": {"status": {"const": "observed"}}, "required": ["status"]}, "then": {"properties": {"value": {"type": "number"}, "observedAt": {"type": "string"}}}}
        ]
      }
    }
  }
}
