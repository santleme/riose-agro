{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riose.invalid/schemas/ranch-source-scene-adapter-v2.schema.json",
  "title": "Riose ranch source-scene adapter v2",
  "description": "Lossless wrapper for the ranch composition pixel scene. It does not convert pixel geometry to the simulation-oriented visual-scene v1 contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapterVersion", "sourceFormat", "sourceScene", "placements", "assets", "unknownSourceFields"],
  "properties": {
    "adapterVersion": {"const": "2.0.0"},
    "sourceFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatId", "schemaVersion", "sceneId", "sourceDigest", "derivedDigest", "coordinateFrame", "ids"],
      "properties": {
        "formatId": {"const": "riose-ranch-composition-v4"},
        "schemaVersion": {"type": "string"},
        "sceneId": {"type": "string", "minLength": 1},
        "sourceDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "derivedDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "coordinateFrame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frameId", "units", "footprintPx", "projection", "originConvention", "gridMappingStatus"],
          "properties": {
            "frameId": {"const": "ranch-composition-v4-canvas-pixel"},
            "units": {"const": "px"},
            "footprintPx": {"$ref": "#/$defs/pair"},
            "projection": {"type": "string"},
            "originConvention": {"type": "string"},
            "gridMappingStatus": {"const": "unsupported"}
          }
        },
        "ids": {
          "type": "object",
          "additionalProperties": false,
          "required": ["placementIds", "assetIds", "zoneIds", "prefabIds"],
          "properties": {
            "placementIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "assetIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "zoneIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "prefabIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        }
      }
    },
    "sourceScene": {"type": "object", "required": ["schemaVersion", "sceneId", "footprintPx", "placements"], "properties": {"schemaVersion": {"const": 1}, "sceneId": {"type": "string"}, "footprintPx": {"$ref": "#/$defs/pair"}, "placements": {"type": "array", "items": {"type": "object", "required": ["placementId", "assetId", "anchorPx", "requestedSizePx", "transform", "depthKey", "block"], "properties": {"placementId": {"type": "string"}, "assetId": {"type": "string"}, "anchorPx": {"$ref": "#/$defs/pair"}, "requestedSizePx": {"$ref": "#/$defs/pair"}, "transform": {"type": "object"}, "depthKey": {"type": "number"}, "block": {"type": "string"}}}}}},
    "placements": {"type": "array", "items": {"type": "object", "required": ["placementId", "assetId", "anchorPx", "requestedSizePx", "transform", "depthKey", "block", "canonicalAsset"], "properties": {"placementId": {"type": "string"}, "assetId": {"type": "string"}, "anchorPx": {"$ref": "#/$defs/pair"}, "requestedSizePx": {"$ref": "#/$defs/pair"}, "transform": {"type": "object"}, "depthKey": {"type": "number"}, "block": {"type": "string"}, "canonicalAsset": {"$ref": "#/$defs/resolvedAsset"}}}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/resolvedAsset"}},
    "unknownSourceFields": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "reason", "disposition"], "properties": {"path": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "disposition": {"const": "preserved"}, "sourceId": {"type": "string"}}}}
  },
  "$defs": {
    "pair": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "resolvedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "canonicalStatus", "canonicalReview", "canonicalRights", "pilotScope"],
      "properties": {
        "assetId": {"type": "string"},
        "canonicalStatus": {"type": "string"},
        "canonicalReview": {},
        "canonicalRights": {},
        "pilotScope": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["artDecision", "technicalDecision", "releasePromotion"], "properties": {"artDecision": {"type": ["string", "null"]}, "technicalDecision": {"type": ["string", "null"]}, "releasePromotion": {"const": false}}}]}
      }
    }
  }
}
