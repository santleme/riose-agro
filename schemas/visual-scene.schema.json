{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riose.local/schemas/visual-scene-1.0.0.schema.json",
  "title": "Riose renderer-independent scene and scenario contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sceneId", "name", "domainModule", "simulation", "projection", "assets", "entities", "zones", "prefabs", "layerOrder"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "sceneId": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "domainModule": {"$ref": "#/$defs/scienceModuleRef"},
    "simulation": {"$ref": "#/$defs/scenarioRun"},
    "snapshot": {"$ref": "#/$defs/snapshotRef"},
    "projection": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "cellWidth", "cellHeight", "columns", "rows"],
      "properties": {
        "type": {"const": "isometric-2to1"},
        "cellWidth": {"type": "number", "exclusiveMinimum": 0},
        "cellHeight": {"type": "number", "exclusiveMinimum": 0},
        "columns": {"type": "integer", "minimum": 1},
        "rows": {"type": "integer", "minimum": 1}
      }
    },
    "assets": {"type": "array", "items": {"$ref": "#/$defs/assetRef"}, "uniqueItems": true},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}, "uniqueItems": true},
    "zones": {"type": "array", "items": {"$ref": "#/$defs/zone"}},
    "prefabs": {"type": "array", "items": {"$ref": "#/$defs/prefab"}},
    "layerOrder": {"type": "array", "items": {"enum": ["terrain", "infrastructure", "livestock", "overlays"]}, "uniqueItems": true},
    "events": {"type": "array", "items": {"$ref": "#/$defs/eventEnvelope"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"},
    "position": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "unit"],
      "properties": {
        "x": {"type": "number"}, "y": {"type": "number"},
        "unit": {"enum": ["grid-cell", "world-meter"]},
        "z": {"type": "number", "default": 0}
      }
    },
    "footprint": {
      "type": "object", "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {"columns": {"type": "number", "exclusiveMinimum": 0}, "rows": {"type": "number", "exclusiveMinimum": 0}}
    },
    "visualState": {
      "type": "object", "additionalProperties": false,
      "required": ["stateId"],
      "properties": {"stateId": {"$ref": "#/$defs/id"}, "variantId": {"$ref": "#/$defs/id"}, "frameSetId": {"$ref": "#/$defs/id"}}
    },
    "assetRef": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "manifestUri", "manifestVersion"],
      "properties": {
        "assetId": {"$ref": "#/$defs/id"},
        "manifestUri": {"type": "string", "minLength": 1},
        "manifestVersion": {"type": "string", "minLength": 1},
        "variantId": {"$ref": "#/$defs/id"}
      }
    },
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["entityId", "kind", "position", "state"],
      "properties": {
        "entityId": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["animal", "structure", "equipment", "vegetation", "terrain"]},
        "position": {"$ref": "#/$defs/position"},
        "asset": {"$ref": "#/$defs/assetRef"},
        "state": {"$ref": "#/$defs/visualState"},
        "domainEntityId": {"$ref": "#/$defs/id"}
      }
    },
    "zone": {
      "type": "object", "additionalProperties": false,
      "required": ["zoneId", "kind", "origin", "footprint", "groundAssetId"],
      "properties": {
        "zoneId": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["pasture", "handling", "water", "farmstead", "crop"]},
        "origin": {"$ref": "#/$defs/position"},
        "footprint": {"$ref": "#/$defs/footprint"},
        "groundAssetId": {"$ref": "#/$defs/id"},
        "transitionAssetIds": {"type": "object", "additionalProperties": {"$ref": "#/$defs/id"}},
        "domainZoneId": {"$ref": "#/$defs/id"}
      }
    },
    "prefab": {
      "type": "object", "additionalProperties": false,
      "required": ["prefabId", "assetId", "position", "footprint", "layer", "state"],
      "properties": {
        "prefabId": {"$ref": "#/$defs/id"},
        "assetId": {"$ref": "#/$defs/id"},
        "position": {"$ref": "#/$defs/position"},
        "footprint": {"$ref": "#/$defs/footprint"},
        "layer": {"enum": ["infrastructure", "livestock", "overlays"]},
        "state": {"$ref": "#/$defs/visualState"},
        "blocking": {"type": "boolean", "default": true},
        "rotationSteps": {"type": "integer", "minimum": 0, "maximum": 3, "default": 0}
      }
    },
    "eventEnvelope": {
      "type": "object", "additionalProperties": false,
      "required": ["eventId", "eventType", "occurredAt", "sourceModule", "payload"],
      "properties": {
        "eventId": {"$ref": "#/$defs/id"}, "eventType": {"$ref": "#/$defs/id"},
        "occurredAt": {"type": "number", "minimum": 0}, "sourceModule": {"$ref": "#/$defs/id"},
        "entityId": {"$ref": "#/$defs/id"}, "payload": {"type": "object"}
      }
    },
    "snapshotRef": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshotId", "schemaVersion", "digest"],
      "properties": {
        "snapshotId": {"$ref": "#/$defs/id"}, "schemaVersion": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "uri": {"type": "string"}
      }
    },
    "scienceModuleRef": {
      "type": "object", "additionalProperties": false,
      "required": ["moduleId", "version", "status"],
      "properties": {
        "moduleId": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["demonstrative-unvalidated", "observational", "calibrated", "validated", "in-progress"]},
        "modelIds": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
      }
    },
    "scenarioRun": {
      "type": "object", "additionalProperties": false,
      "required": ["scenarioId", "seed", "populationCount", "productionSystem", "initialConditions"],
      "properties": {
        "scenarioId": {"$ref": "#/$defs/id"}, "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "populationCount": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "productionSystem": {"enum": ["beef", "dairy", "mixed"]},
        "initialConditions": {"type": "object"},
        "simulationSnapshotId": {"$ref": "#/$defs/id"}
      }
    }
  }
}
