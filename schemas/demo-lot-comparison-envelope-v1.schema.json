{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://santleme.github.io/riose-agro/schemas/demo-lot-comparison-envelope-v1.schema.json",
  "title": "Riose registered demo lot comparison envelope",
  "description": "Adds lot identity and demo-model provenance to an existing configured comparison without changing its engine contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "manifest", "lotContext"],
  "properties": {
    "type": {"const": "riose-demo-lot-comparison-envelope"},
    "version": {"const": 1},
    "manifest": {"$ref": "configured-comparison-manifest-v1.schema.json"},
    "lotContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "source", "lotId", "patchIndex", "animalIds", "model", "intervention"],
      "properties": {
        "type": {"const": "riose-demo-lot-context"},
        "version": {"const": 1},
        "source": {"const": "registered-demonstrative-scenario"},
        "lotId": {"type": "string", "pattern": "^demo-paddock-[1-4]$"},
        "patchIndex": {"type": "integer", "minimum": 0, "maximum": 3},
        "animalIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "model": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version", "status"],
          "properties": {
            "id": {"const": "riose-registered-demo-lot"},
            "version": {"const": "1.0.0"},
            "status": {"const": "demonstrative_unvalidated"}
          }
        },
        "intervention": {
          "type": "object", "additionalProperties": false,
          "required": ["factor", "referenceValue", "scenarioValue"],
          "properties": {
            "factor": {"enum": ["diet", "housing", "weather", "supplement"]},
            "referenceValue": {},
            "scenarioValue": {}
          }
        }
      }
    }
  }
}
