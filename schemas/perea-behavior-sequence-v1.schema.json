{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riose.agro/schemas/perea-behavior-sequence-v1.schema.json",
  "title": "Experimental Perea annotated behavior sequence",
  "description": "A minute-indexed research-only generated label sequence with training provenance. It is not a FarmEngine state or a biological validation record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidate", "source", "training", "replicate", "seedHex", "requestedMinutes", "generatedMinutes", "supportedBehaviors", "unsupportedBehaviors", "observations", "limitations"],
  "properties": {
    "schemaVersion": {"const": "perea.behavior-sequence.v1"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "status"],
      "properties": {
        "id": {"const": "perea-semi-markov-experimental"},
        "version": {"type": "string", "minLength": 1},
        "status": {"const": "research_only"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["doi", "md5"],
      "properties": {
        "doi": {"const": "10.6084/m9.figshare.28801181.v2"},
        "md5": {"const": "7cd143e8cccc79a5e159eaa83428529f"}
      }
    },
    "training": {
      "type": "object", "additionalProperties": false,
      "required": ["fold", "animalIds"],
      "properties": {
        "fold": {"type": "integer", "minimum": 0, "maximum": 4},
        "animalIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2}:[^:]+$"}}
      }
    },
    "replicate": {"type": "integer", "minimum": 0},
    "seedHex": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "requestedMinutes": {"type": "integer", "minimum": 0},
    "generatedMinutes": {"type": "integer", "minimum": 0},
    "supportedBehaviors": {"$ref": "#/$defs/behaviors"},
    "unsupportedBehaviors": {"$ref": "#/$defs/behaviors"},
    "observations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["minuteIndex", "behavior"],
        "properties": {
          "minuteIndex": {"type": "integer", "minimum": 0},
          "behavior": {"enum": ["WA", "GR", "RE", "RU"]}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "behaviors": {"type": "array", "uniqueItems": true, "items": {"enum": ["WA", "GR", "RE", "RU"]}}
  }
}
