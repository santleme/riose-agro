{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riose-agro.local/schemas/benchmark-report-v1.json",
  "title": "Riose benchmark report",
  "type": "object",
  "required": ["schemaVersion", "benchmark", "runtime", "hardware", "workload", "configuration", "limits", "phases", "timingBoundaries", "results", "limitations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "benchmark": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "required": ["revision", "dirty"],
          "properties": {"revision": {"type": ["string", "null"]}, "dirty": {"type": "boolean"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtime": {"type": "object", "required": ["platform"], "properties": {"platform": {"type": "string"}, "node": {"type": "string"}}, "additionalProperties": true},
    "hardware": {
      "type": "object",
      "required": ["os", "architecture", "cpu", "gpuMemoryBytes"],
      "properties": {"os": {"type": ["string", "null"]}, "architecture": {"type": ["string", "null"]}, "cpu": {"type": ["string", "null"]}, "gpuMemoryBytes": {"type": ["integer", "null"], "minimum": 0}},
      "additionalProperties": true
    },
    "workload": {
      "type": "object",
      "required": ["seed", "populations"],
      "properties": {
        "seed": {"type": ["integer", "string"], "minLength": 1},
        "populations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["scope"], "properties": {"animals": {"type": "integer", "minimum": 0}, "count": {"type": "integer", "minimum": 0}, "unit": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "limit": {"type": ["string", "null"]}}, "anyOf": [{"required": ["animals"]}, {"required": ["count", "unit"]}], "allOf": [{"if": {"properties": {"animals": {"minimum": 100000}}, "required": ["animals"]}, "then": {"properties": {"scope": {"const": "numeric-kernel-only"}, "animals": {"maximum": 100000}}}}, {"if": {"properties": {"scope": {"pattern": "[Ff][Aa][Rr][Mm][Ee][Nn][Gg][Ii][Nn][Ee]|[Rr][Ee][Nn][Dd][Ee][Rr][Ee][Rr]"}}, "required": ["scope"]}, "then": {"properties": {"animals": {"maximum": 10000}}}}], "additionalProperties": true}}
      },
      "additionalProperties": true
    },
    "configuration": {"type": "object", "required": ["warmupRuns", "repetitions"], "properties": {"warmupRuns": {"type": ["integer", "object", "null"]}, "repetitions": {"type": ["integer", "null"]}}, "additionalProperties": true},
    "limits": {"type": "object", "required": ["farmEngineMaxAnimals", "rendererMaxAnimals", "numericKernelMaxAnimalsMeasured"], "properties": {"farmEngineMaxAnimals": {"type": ["integer", "null"]}, "rendererMaxAnimals": {"type": ["integer", "null"]}, "numericKernelMaxAnimalsMeasured": {"type": ["integer", "null"]}}, "additionalProperties": true},
    "phases": {
      "type": "object",
      "required": ["engine", "snapshot", "serialization", "worker", "ui", "layout", "render", "startup"],
      "properties": {
        "engine": {"$ref": "#/$defs/phase"}, "snapshot": {"$ref": "#/$defs/phase"}, "serialization": {"$ref": "#/$defs/phase"}, "worker": {"$ref": "#/$defs/phase"},
        "ui": {"$ref": "#/$defs/phase"}, "layout": {"$ref": "#/$defs/phase"}, "render": {"$ref": "#/$defs/phase"}, "startup": {"$ref": "#/$defs/phase"}
      },
      "additionalProperties": false
    },
    "timingBoundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase", "timed", "notTimed"],
        "properties": {
          "phase": {"enum": ["engine", "snapshot", "serialization", "worker", "ui", "layout", "render", "startup"]},
          "timed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "notTimed": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "results": {"type": ["object", "array"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": ["status", "measurements"],
      "properties": {"status": {"enum": ["measured", "not-measured", "unavailable"]}, "measurements": {"type": "array", "items": {"type": "object", "required": ["phase", "metric", "unit", "statistics", "population", "source"], "properties": {"phase": {"type": "string"}, "metric": {"type": "string"}, "unit": {"type": "string", "minLength": 1}, "statistics": {"type": "object"}, "population": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "minLength": 1}, {"type": "object", "minProperties": 1}]}, "source": {"type": "string", "minLength": 1}}, "additionalProperties": true}}},
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
